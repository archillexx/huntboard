# Copy to .env and fill in. .env is gitignored; this file is the template.
DATABASE_URL=postgresql+psycopg://YOUR_MAC_USERNAME@localhost:5432/job_tracker
# Your own key from platform.openai.com; never commit the real one.
OPENAI_API_KEY=sk-your-key-here
# Signs login tokens. Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
# Email via resend.com. Leave empty locally to print emails in the terminal instead.
RESEND_API_KEY=re_your-key-here
# Sender address. Until you verify your own domain in Resend, keep the test sender.
EMAIL_FROM=Huntboard <onboarding@resend.dev>
# Set to "production" on the live server: emails must then really send (never print).
APP_ENV=development
# Browser origins allowed to call the API (CORS), comma-separated. Add the live site's URL in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
