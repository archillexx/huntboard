{
  "manifest_version": 3,
  "name": "Huntboard",
  "version": "0.1.0",
  "description": "Save the job you're looking at to Huntboard in one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Huntboard"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://huntboard-api-htbm.onrender.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@huntboard.dev",
      "strict_min_version": "115.0"
    }
  }
}
